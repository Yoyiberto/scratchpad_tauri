{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratchpad",
  "version": "0.1.0",
  "identifier": "com.ramse.scratchpad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Scratchpad",
        "width": 520,
        "height": 720,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
